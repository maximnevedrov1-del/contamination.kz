{
  "manifest_version": 3,
  "name": "SaudaPulse",
  "short_name": "SaudaPulse",
  "version": "0.1.0",
  "description": "Orders, returns, refusals, payments, analytics and customer chat from all your Kaspi.kz stores in one place.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SaudaPulse",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://kaspi.kz/mc/*",
    "https://*.kaspi.kz/*",
    "http://localhost/*",
    "file:///*/mc/store-*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kaspi.kz/mc/*",
        "https://*.kaspi.kz/*",
        "http://localhost/*",
        "file:///*/mc/store-*"
      ],
      "js": [
        "content/network-tap.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kaspi.kz/mc/*",
        "https://*.kaspi.kz/*",
        "http://localhost/*",
        "file:///*/mc/store-*"
      ],
      "js": [
        "shared/selectors.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' blob:"
  }
}
